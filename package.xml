<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mmr_ros_graph</name>
  <version>0.2.0</version>
  <description>Live browser view and diagnostics cockpit for a ROS 2 graph: nodes, QoS wires, parameters, topic monitor, and /rosout console.</description>
  <maintainer email="392180@studenti.unimore.it">saish</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
